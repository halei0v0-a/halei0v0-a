---
/**
 * AnalyticsScripts.astro
 * 第三方分析脚本组件 - 延迟加载优化
 *
 * 包含:
 * - Google Tag Manager (GTM)
 * - Microsoft Clarity (可选，通过 thirdPartyAnalytics 配置控制)
 *
 * 使用 requestIdleCallback 延迟加载以优化性能
 */

interface Props {
	gtmId?: string;
	thirdPartyAnalytics?: {
		enable: boolean;
		clarityId?: string;
		umami?: {
			websiteId: string;
			scriptUrl?: string;
			shareUrl?: string;
		};
	};
}

const {
	gtmId = "GTM-KRX3XGVH",
	thirdPartyAnalytics = { enable: false, clarityId: "" },
} = Astro.props;

const clarityEnable =
	thirdPartyAnalytics.enable && thirdPartyAnalytics.clarityId;

const umami = thirdPartyAnalytics.umami;
const umamiEnable = thirdPartyAnalytics.enable && umami?.websiteId;
const umamiShareUrl = umami?.shareUrl || "";
---

<!-- Umami Analytics - 延迟加载优化 -->
{
	umamiEnable && (
		<script
			is:inline
			defer
			data-swup-ignore-script
			src={umami.scriptUrl || "https://cloud.umami.is/script.js"}
			data-website-id={umami.websiteId}
		></script>
	)
}

<!-- Umami 统计数据显示（读取分享数据，供侧栏/文章浏览量展示） -->
{
	umamiEnable && umamiShareUrl && (
		<script
			is:inline
			data-swup-ignore-script
			define:vars={{ umamiShareUrl }}
		>
			(function () {
				if (window.oddmisc) {
					return;
				}

				let shareData = null;
				let sharePromise = null;
				const cache = new Map();

				function parseShareUrl(shareUrl) {
					const url = new URL(shareUrl);
					const segments = url.pathname.split("/");
					const shareIndex = segments.indexOf("share");
					if (shareIndex === -1 || shareIndex === segments.length - 1) {
						throw new Error("Invalid share URL");
					}
					const shareId = segments[shareIndex + 1];
					const apiBase =
						url.protocol +
						"//" +
						url.host +
						segments.slice(0, shareIndex).join("/") +
						"/api";
					return { apiBase, shareId };
				}

				function getShareData(apiBase, shareId) {
					if (shareData) {
						return Promise.resolve(shareData);
					}
					if (sharePromise) {
						return sharePromise;
					}
					sharePromise = fetch(apiBase + "/share/" + shareId)
						.then((res) => {
							if (!res.ok) {
								sharePromise = null;
								throw new Error("Share data fetch failed: " + res.status);
							}
							return res.json();
						})
						.then((data) => {
							shareData = data;
							return data;
						});
					return sharePromise;
				}

				async function getStats(path) {
					const key = path || "site";
					if (cache.has(key)) {
						return Promise.resolve({ ...cache.get(key), _fromCache: true });
					}

					const { apiBase, shareId } = parseShareUrl(umamiShareUrl);
					const { websiteId, token } = await getShareData(apiBase, shareId);
					const params = new URLSearchParams({
						startAt: "0",
						endAt: Date.now().toString(),
					});
					if (path) {
						params.set("path", "eq." + path);
					}

					const res = await fetch(
						apiBase + "/websites/" + websiteId + "/stats?" + params.toString(),
						{
							headers: {
								"x-umami-share-token": token,
								"x-umami-share-context": "1",
							},
						},
					);
					if (!res.ok) {
						throw new Error("Stats fetch failed: " + res.status);
					}
					const data = await res.json();
					const result = {
						pageviews:
							(data.pageviews && data.pageviews.value != null)
								? data.pageviews.value
								: (data.pageviews || 0),
						visitors:
							(data.visitors && data.visitors.value != null)
								? data.visitors.value
								: (data.visitors || 0),
						visits:
							(data.visits && data.visits.value != null)
								? data.visits.value
								: (data.visits || 0),
					};
					cache.set(key, result);
					return result;
				}

				window.oddmisc = {
					getStats: (path) => getStats(path),
					getSiteStats: () => getStats(),
					getPageStats: (path) => getStats(path),
					clearCache: () => cache.clear(),
				};
			})();
		</script>
	)
}

<!-- 第三方分析脚本 - 仅在用户交互后延迟加载 -->
<script
	is:inline
	define:vars={{
		gtmId,
		clarityEnable,
		clarityId: thirdPartyAnalytics.clarityId || "",
	}}
>
	(function () {
		// 标记脚本是否已加载
		window.analyticsLoaded = window.analyticsLoaded || false;

		function loadAnalytics() {
			if (window.analyticsLoaded) {
				return;
			}
			window.analyticsLoaded = true;

			// Google Tag Manager
			(function (w, d, s, l, i) {
				w[l] = w[l] || [];
				w[l].push({
					"gtm.start": new Date().getTime(),
					event: "gtm.js",
				});
				const f = d.getElementsByTagName(s)[0],
					j = d.createElement(s);
				j.async = true;
				j.src = "https://www.googletagmanager.com/gtm.js?id=" + i;
				f.parentNode.insertBefore(j, f);
			})(window, document, "script", "dataLayer", gtmId);

			// Clarity (仅在启用时加载)
			if (clarityEnable && clarityId) {
				(function (c, l, a, r, i, t, y) {
					c[a] =
						c[a] ||
						function () {
							(c[a].q = c[a].q || []).push(arguments);
						};
					t = l.createElement(r);
					t.async = 1;
					t.src = "https://www.clarity.ms/tag/" + i;
					y = l.getElementsByTagName(r)[0];
					y.parentNode.insertBefore(t, y);
				})(window, document, "clarity", "script", clarityId);
			}
		}

		// 仅在用户交互后加载分析脚本，减少初始页面加载负担
		const events = [
			"scroll",
			"mousemove",
			"keydown",
			"touchstart",
			"click",
		];
		let loaded = false;

		function onInteraction() {
			if (loaded) {
				return;
			}
			loaded = true;
			events.forEach(function (event) {
				window.removeEventListener(event, onInteraction);
			});
			loadAnalytics();
		}

		events.forEach(function (event) {
			window.addEventListener(event, onInteraction, {
				once: true,
				passive: true,
			});
		});

		// 备用：如果用户 10 秒内没有交互，则在 idle 时加载
		setTimeout(function () {
			if (!loaded) {
				loadAnalytics();
			}
		}, 10000);
	})();
</script>
