---
import { Icon } from "astro-icon/components";

import { siteConfig } from "../../../config";
import WidgetLayout from "../common/WidgetLayout.astro";
import type { WidgetComponentConfig } from "../../../types/config";

interface Props {
  class?: string;
  style?: string;
  widgetConfig?: WidgetComponentConfig;
}

const { class: className, style, widgetConfig } = Astro.props;
const showTitle = widgetConfig?.showTitle !== false;
const siteDomain = (siteConfig.siteURL || "https://example.com")
  .replace(/^https?:\/\//, "")
  .replace(/\/$/, "");
---

<WidgetLayout
  name="站点信息"
  showTitle={showTitle}
  id="site-info"
  class={className}
  style={style}
>
  <div class="flex flex-col gap-2">
    <div class="flex items-center justify-between rounded-lg px-3 py-2 bg-neutral-100/60 dark:bg-neutral-800/50">
      <div class="flex items-center gap-2">
        <div class="text-[var(--primary)]">
          <Icon name="material-symbols:language" />
        </div>
        <span class="text-sm font-medium text-neutral-700 dark:text-neutral-300">站点</span>
      </div>
      <span class="truncate text-xs font-bold text-neutral-900 dark:text-neutral-100">
        {siteDomain}
      </span>
    </div>
    <div class="flex items-center justify-between rounded-lg px-3 py-2 bg-neutral-100/60 dark:bg-neutral-800/50">
      <div class="flex items-center gap-2">
        <div class="text-[var(--primary)]">
          <Icon name="material-symbols:calendar-today" />
        </div>
        <span class="text-sm font-medium text-neutral-700 dark:text-neutral-300">建站日期</span>
      </div>
      <span class="text-xs font-bold text-neutral-900 dark:text-neutral-100">
        {siteConfig.siteStartDate || "2025-01-01"}
      </span>
    </div>
    <div class="flex items-center justify-between rounded-lg px-3 py-2 bg-neutral-100/60 dark:bg-neutral-800/50">
      <div class="flex items-center gap-2">
        <div class="text-[var(--primary)]">
          <Icon name="material-symbols:build-outline" />
        </div>
        <span class="text-sm font-medium text-neutral-700 dark:text-neutral-300">更新时间</span>
      </div>
      <span class="text-xs font-bold text-neutral-900 dark:text-neutral-100">
        {new Date().toLocaleDateString("zh-CN")}
      </span>
    </div>
  </div>
</WidgetLayout>
